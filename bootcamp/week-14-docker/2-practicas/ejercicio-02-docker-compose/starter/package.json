{
  "name": "ejercicio-02-docker-compose",
  "version": "1.0.0",
  "description": "Ejercicio 02 — docker-compose con API Express + PostgreSQL",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.8.2",
    "cors": "2.8.5",
    "dotenv": "16.5.0",
    "express": "5.1.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "5.0.1",
    "@types/node": "22.15.3",
    "prisma": "6.8.2",
    "ts-node-dev": "2.0.0",
    "typescript": "5.8.3"
  }
}
