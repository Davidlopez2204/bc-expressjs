{
  "name": "proyecto-semana-11-notificaciones-rt",
  "version": "1.0.0",
  "description": "Sistema de notificaciones en tiempo real con Socket.io + Express + MongoDB",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "bcrypt": "5.1.1",
    "cors": "2.8.5",
    "dotenv": "16.5.0",
    "express": "5.1.0",
    "express-rate-limit": "7.5.0",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "mongoose": "8.13.2",
    "socket.io": "4.8.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "5.0.2",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.1",
    "@types/jsonwebtoken": "9.0.9",
    "@types/node": "22.15.3",
    "ts-node-dev": "2.0.0",
    "typescript": "5.8.3"
  }
}
